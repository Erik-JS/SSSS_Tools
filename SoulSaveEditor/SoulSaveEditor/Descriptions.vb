    Public Structure AssistPhraseInfo
        Public ReadOnly Quote As String
        Public ReadOnly Description As String
        Public ReadOnly ShortDescription As String
        Public ReadOnly Cost As Integer

        Public Sub New(quote As String, desc As String, shortdesc As String, cost As Integer)
            Me.Quote = quote
            Me.Description = desc
            Me.ShortDescription = shortdesc
            Me.Cost = cost
        End Sub
    End Structure

